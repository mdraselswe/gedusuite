DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth client — used for both "Sign in with Google" and each user's
# personal backup connection (callback: /api/google/personal/callback).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Shared secret checked by the scheduled backup crons (/api/cron/backup,
# /api/cron/personal-backup). Must match the Authorization header Vercel
# Cron sends.
CRON_SECRET=""

# Encrypts stored Google OAuth tokens (personal backup connections). Falls
# back to NEXTAUTH_SECRET if unset — set a distinct value in production.
BACKUP_ENCRYPTION_KEY=""

# Optional: Prisma connection pool tuning (defaults: 10 / 30).
# PRISMA_CONNECTION_LIMIT="10"
# PRISMA_POOL_TIMEOUT="30"

# The WooCommerce website. WP_URL is read for the combo product picker and the
# combo drift check; the write pair is what lets a combo be pushed there as a
# product. Leave the pair blank to keep the connection read-only.
WP_URL="https://wp.example.com"
WC_WRITE_KEY=""
WC_WRITE_SECRET=""

# --- The website's call-list feeds ---------------------------------------
# The WooCommerce store this workspace's website orders belong to. Both the
# order webhook and the abandoned-cart beacon look the workspace up by slug.
WOO_WORKSPACE_SLUG=""

# Shared secret WooCommerce signs its order webhook with (/api/cron/woo-lead).
# Set the same value in WooCommerce → Settings → Advanced → Webhooks.
WOO_WEBHOOK_SECRET=""

# Read-only WooCommerce REST keys. Used by the pull sync, which is the only way
# checkout-drafts — customers who filled the checkout and never pressed Place
# order — can be found; WooCommerce fires no webhook for those.
WC_CONSUMER_KEY=""
WC_CONSUMER_SECRET=""

# Shared secret for the abandoned-cart beacon (/api/cron/abandoned-cart). Must
# match CART_BEACON_SECRET in the storefront's Cloudflare Pages project, which
# is what signs the snapshot — the storefront is a static export and cannot
# hold a secret itself.
CART_BEACON_SECRET=""
