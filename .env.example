# ── Required ───────────────────────────────────────────────────────────
# Pooled connection for the app; unpooled (DIRECT_URL) for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

NEXTAUTH_SECRET="replace-with-a-random-secret"
# The public address of THIS installation. Sign-in callbacks and links in
# emails are built from it.
NEXTAUTH_URL="http://localhost:3000"

# Encrypts stored courier keys, website keys and Google tokens. Set once and do
# not change it afterwards. Falls back to NEXTAUTH_SECRET if unset.
BACKUP_ENCRYPTION_KEY=""

# Shared secret the scheduled endpoints (/api/cron/*) require. Unset = they
# refuse every request.
CRON_SECRET=""

# ── Sign-in with Google, and Drive backups ─────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Email (verification, password reset, reminders) ────────────────────
# Without RESEND_API_KEY mail is logged, not sent.
RESEND_API_KEY=""
MAIL_FROM="GeduSuite <no-reply@your-domain.example>"

# ── Running it as a service ────────────────────────────────────────────
# Who can open /admin (comma-separated, must be verified accounts).
PLATFORM_ADMIN_EMAILS=""
# Where customers send plan payments, and who they contact.
BILLING_BKASH_NUMBER=""
BILLING_NAGAD_NUMBER=""
BILLING_BANK_DETAILS=""
BILLING_SUPPORT_EMAIL=""
BILLING_SUPPORT_PHONE=""
# "on" applies plan limits and the read-only lapse. Off by default.
# BILLING_ENFORCEMENT="on"

# ── Optional ───────────────────────────────────────────────────────────
# Off-site encrypted backup copy (any S3-compatible bucket, e.g. Cloudflare R2).
# BACKUP_S3_ENDPOINT=""
# BACKUP_S3_BUCKET=""
# BACKUP_S3_ACCESS_KEY=""
# BACKUP_S3_SECRET_KEY=""
# BACKUP_S3_REGION="auto"
# Error reporting.
# SENTRY_DSN=""
# Public address used in emails if different from NEXTAUTH_URL.
# APP_URL=""

# Prisma connection pool tuning (defaults: 10 / 30).
# PRISMA_CONNECTION_LIMIT="10"
# PRISMA_POOL_TIMEOUT="30"

# ── Single-shop mode only ──────────────────────────────────────────────
# A deployment that serves ONE shop can describe its WooCommerce site here
# instead of in Settings → Website. A multi-customer installation leaves all of
# these unset: each customer connects their own site in their own workspace.
# WP_URL=""
# WC_CONSUMER_KEY=""
# WC_CONSUMER_SECRET=""
# WC_WRITE_KEY=""
# WC_WRITE_SECRET=""
# WOO_WORKSPACE_SLUG=""
# WOO_WEBHOOK_SECRET=""
# CART_BEACON_SECRET=""
