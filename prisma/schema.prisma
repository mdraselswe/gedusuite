// GeduSuite — Prisma schema
// Phase 0: multi-tenancy (Workspace, User, Membership) + NextAuth adapter tables.
// Later phases add Product, Purchase, Order, Partner, Treasury, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations bypass the pgbouncer pooler: advisory locks are session-level
  // and get stranded on pooled backends, deadlocking every next migrate run.
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  PARTNER
  MANAGER
  STAFF
}

// ── Multi-tenancy core ──────────────────────────────────────────────

model Workspace {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique // used in /[workspace]/... routes
  logoUrl    String?
  themeColor String?
  // Shown on printed order forms so a customer holding a parcel knows where to
  // order again. Stored per workspace rather than hardcoded — the printed
  // documents are shared code and every shop's address is its own.
  websiteUrl String?
  createdAt  DateTime @default(now())

  memberships           Membership[]
  invites               Invite[]
  suppliers             Supplier[]
  products              Product[]
  purchases             Purchase[]
  notifications         Notification[]
  customers             Customer[]
  orders                Order[]
  returns               Return[]
  partners              Partner[]
  partnerTxns           PartnerTxn[]
  treasury              TreasuryEntry[]
  internalPurchases     InternalPurchase[]
  backupLogs            BackupLog[]
  backupSetting         BackupSetting?
  stockAdjustments      StockAdjustment[]
  productCategories     ProductCategory[]
  userGoogleConnections UserGoogleConnection[]
  profitDistributions   ProfitDistribution[]
  boostCampaigns        BoostCampaign[]
  boostAdSets           BoostAdSet[]
  boostDailySpends      BoostDailySpend[]
  orderLeads            OrderLead[]
  couriers              Courier[]
  courierZones          CourierZone[]
  courierRateBands      CourierRateBand[]
  courierPayouts        CourierPayout[]
  activity              ActivityLog[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? // required by NextAuth adapter
  image         String?
  passwordHash  String? // null for OAuth-only users
  theme         String    @default("system") // light | dark | system
  colorPreset   String    @default("indigo") // indigo | green | rose | amber
  locale        String    @default("en") // en | bn
  createdAt     DateTime  @default(now())

  accounts         Account[]
  sessions         Session[]
  memberships      Membership[]
  partners         Partner[]
  googleConnection UserGoogleConnection?
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        Role     @default(STAFF)
  permissions Json? // per-module granular overrides on top of the role matrix
  invitedBy   String? // userId of the inviter (null for the founding OWNER)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  heldOrders Order[]       @relation("OrderHeldBy")
  activity   ActivityLog[]

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  workspaceId String
  role        Role      @default(STAFF)
  token       String    @unique
  invitedBy   String // userId of the inviter
  acceptedAt  DateTime?
  // Invites are shared over WhatsApp and never come back, so a token with no
  // end date is a standing offer of a role. One from six months ago worked
  // exactly as well as one from this morning.
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([email, workspaceId])
  @@index([workspaceId])
}

// ── NextAuth adapter tables ─────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Phase 1: Products & Purchases ───────────────────────────────────

model Supplier {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  address     String?
  phone       String?
  altPhone    String?
  notes       String?
  createdAt   DateTime @default(now())

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  purchases         Purchase[]
  internalPurchases InternalPurchase[]

  @@index([workspaceId])
}

model Product {
  id                String   @id @default(cuid())
  workspaceId       String
  name              String
  category          String?
  sku               String? // optional product-level SKU
  barcode           String?
  imageUrl          String? // stored as a data URI (Phase 1); blob storage later
  expiryTracked     Boolean  @default(false)
  lowStockThreshold Int      @default(5) // default for each variant; a variant may override it
  // Pack-based products (e.g. hair clips, 10 per packet): stock is ALWAYS
  // tracked in single pieces; this just enables Packet<->Piece conversion in
  // the purchase/order forms and "N pkt + M pcs" stock display. null/1 = no packs.
  unitsPerPack      Int?
  // Shipping weight of ONE piece, in grams. Feeds the courier quote: above
  // the courier's base weight every started kilo is charged, so this is the
  // difference between a guessed cost and the real one. Null = unknown, and
  // the order form then asks for the parcel weight by hand rather than
  // pretending a heavy order weighs nothing.
  weightGrams       Int?
  // Ordered list of attribute names this product varies on, e.g. ["Size","Color"].
  // Each ProductVariant.attributes carries a value for these. [] = single variant.
  attributeNames    Json     @default("[]")
  createdAt         DateTime @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  variants  ProductVariant[]

  @@index([workspaceId])
}

// Managed category list per workspace — the product form selects from these
// instead of free-typing, but new ones can be added inline (see
// createProductCategory). Seeded with baby-product defaults on first use.
model ProductCategory {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  // The variant's attribute combination as [{ name, value }], e.g.
  // [{ "name": "Size", "value": "M" }, { "name": "Color", "value": "Red" }].
  // [] = the product's single default variant.
  attributes        Json     @default("[]")
  sku               String?
  // Per-variant catalogue pricing; used as the default in purchase/order forms.
  salePrice         Decimal? @db.Decimal(12, 2) // default selling price per piece
  unitCost          Decimal? @db.Decimal(12, 2) // default buying cost per piece
  barcode           String?
  imageUrl          String? // data URI (Phase 1), like Product.imageUrl
  // Overrides Product.lowStockThreshold for this variant when set.
  lowStockThreshold Int?
  description       String? // short note shown with the variant

  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchases   Purchase[]
  orderItems  OrderItem[]
  orderGifts  OrderGift[]
  adjustments StockAdjustment[]

  @@index([productId])
}

model Purchase {
  id               String    @id @default(cuid())
  workspaceId      String
  supplierId       String?
  productVariantId String
  paidByPartnerId  String? // which partner's money funded this purchase (optional)
  paidFromTreasury Boolean   @default(false) // funded from the shared treasury instead of a partner (mutually exclusive with paidByPartnerId)
  // Taken on credit and not paid for yet — the goods are here, the money is
  // still owed to the supplier. Mutually exclusive with the two above, and the
  // one funding state the app had no way to record: stock bought on terms
  // looked exactly like stock somebody forgot to tag, so a real liability
  // showed up as spent partner capital and nowhere as a debt.
  onCredit         Boolean   @default(false)
  date             DateTime  @default(now())
  /// Whether `date` carries a real time of day, or only a day.
  /// The forms ask for both now, so a new row's `date` is the moment the sale
  /// was made or the money moved. Rows entered before that — and this column is
  /// false for every one of them — hold midnight UTC, and the time worth showing
  /// for those is when they were entered (see lib/dhaka-time). Testing the
  /// timestamp instead of storing this cannot tell the two apart: 6 AM in Dhaka
  /// IS midnight UTC.
  dateHasTime      Boolean   @default(false)
  unitCost         Decimal   @db.Decimal(12, 2)
  salePrice        Decimal?  @db.Decimal(12, 2) // intended per-unit selling price, noted at purchase time
  quantity         Int
  expiryDate       DateTime?
  createdAt        DateTime  @default(now())

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplier       Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  paidByPartner  Partner?       @relation(fields: [paidByPartnerId], references: [id], onDelete: SetNull)
  treasuryEntry  TreasuryEntry?
  partnerTxn     PartnerTxn? // the INVESTMENT credit mirroring a partner-funded purchase

  @@index([workspaceId])
  @@index([workspaceId, date])
  @@index([productVariantId])
  @@index([supplierId])
  @@index([paidByPartnerId])
}

enum NotificationType {
  LOW_STOCK
  EXPIRY
  OVERDUE_PAYMENT
  NEW_ORDER
  GENERAL
}

model Notification {
  id          String           @id @default(cuid())
  workspaceId String
  type        NotificationType
  message     String
  link        String? // in-app path this notification points at (clicking navigates there)
  dedupeKey   String? // stable key so recurring alerts upsert instead of duplicating
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId])
}

// ── Phase 2: Customers, Orders, Returns ─────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  // Picked, packed and waiting for the courier. Consumes stock like CONFIRMED
  // does — the goods are physically committed to this order by now.
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

/**
 * Where a cancelled order's goods have got to on the way back.
 *
 * Cancelling settles the money the same day; the goods take a week. A refused
 * parcel sits in the courier's return hub for days, and until this existed the
 * app put those pieces back on the shelf the moment the order was cancelled —
 * so they could be sold again while nobody had them, the low-stock alert
 * cleared itself and no reorder went in, and a parcel the courier simply lost
 * stayed on the books forever as stock that was never there.
 *
 * Deliberately not a sixth OrderStatus. A cancelled order is cancelled — it
 * earns nothing, and every report is right to treat it that way. This says
 * only where the pieces are, and nothing else reads it.
 */
enum ReturnLeg {
  /// No goods are coming back: cancelled before it was packed, or handed over
  /// in person and taken straight back. The default, and what every order that
  /// predates this column is.
  NONE
  /// With the courier, travelling back. Still counted OUT of stock.
  IN_TRANSIT
  /// Physically back in the shop. Stock restored; anything that came back
  /// broken or short is a StockAdjustment of its own.
  RECEIVED
  /// Never arrived. The pieces return to stock and a LOST adjustment takes
  /// them straight back out, so the loss has a cost and a date against it
  /// instead of quietly inflating the shelf.
  LOST
}

/**
 * What a courier's percentage fee is charged on.
 * The single field that makes one courier's rules portable to the next.
 * Steadfast takes its 1% of what it actually hands over (COD minus its own
 * delivery charge); others take it on the full COD. On a 960 parcel that is
 * 8.45 versus 9.60 — small alone, wrong every single order.
 */
enum CodFeeBase {
  GROSS // % of the whole COD amount
  NET // % of (COD − delivery charge)
}

enum ReturnChargeType {
  NONE
  FLAT
  PERCENT_OF_DELIVERY
}

/**
 * A courier company's pricing rules, held as data rather than code so that
 * switching or adding one is a form to fill in, not a deployment.
 * Rates are per workspace, never global: the published price list and what a
 * merchant actually negotiated are different numbers — this shop pays 65
 * inside Dhaka where the public calculator quotes 50.
 */
model Courier {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  /**
   * Offered first on the order form. Only one per workspace is enforced in code.
   */
  isDefault   Boolean @default(false)
  isActive    Boolean @default(true)

  /**
   * Weight included in the zone rate; anything above is charged per kg.
   */
  baseWeightKg      Decimal          @default(1) @db.Decimal(6, 3)
  /**
   * Per started kg above baseWeightKg — couriers round part-kilos up.
   */
  extraKgRate       Decimal          @default(0) @db.Decimal(12, 2)
  codFeePercent     Decimal          @default(0) @db.Decimal(6, 3)
  codFeeBase        CodFeeBase       @default(NET)
  returnChargeType  ReturnChargeType @default(NONE)
  returnChargeValue Decimal          @default(0) @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime         @default(now())

  /**
   * Which courier's API this row can book parcels through — "STEADFAST", or
   * null for a courier that is only ever booked by hand. A string rather than
   * an enum so the second integration is a client file, not a migration.
   */
  /**
   * When this courier's in-flight parcels were last asked about. Throttles the
   * sync the sales page kicks off, so opening the list ten times in a minute
   * asks the courier once — the same arrangement wooSyncState gives the call
   * list, kept on the courier because that is what has the credentials.
   */
  statusSyncedAt DateTime?

  apiProvider   String?
  /**
   * The courier's API credentials, AES-256-GCM encrypted by lib/crypto (the
   * same helper that holds Google OAuth tokens). Per workspace and not in the
   * environment, because every workspace books through its own account — an
   * env var would ship one shop's key to all of them.
   */
  apiKeyEnc     String?
  apiSecretEnc  String?
  /**
   * Random path segment on this workspace's webhook URL. The courier posts
   * delivery updates to /api/cron/steadfast/<webhookToken>; that prefix is
   * public (proxy.ts), so the token is the only thing standing between the
   * open internet and a status write. Rotating it is a new random value here
   * and a paste into the courier's portal.
   */
  webhookToken  String? @unique
  /**
   * The bearer token the courier is told to send back on every webhook call.
   * Steadfast's webhook form takes a callback URL *and* an auth token, which
   * makes the URL's own token an identifier rather than the whole of the
   * security: the path says which workspace this is about, and this says the
   * caller is really Steadfast. Kept separate from webhookToken so that a URL
   * leaking through a proxy log does not hand anyone the ability to write
   * delivery statuses.
   */
  webhookSecret String?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  zones     CourierZone[]
  orders    Order[]
  payouts   CourierPayout[]

  @@index([workspaceId])
}

/**
 * One delivery area and its flat rate up to the courier's base weight.
 */
model CourierZone {
  id          String  @id @default(cuid())
  workspaceId String
  courierId   String
  name        String // "Dhaka City", "Outside Dhaka"…
  /**
   * What this zone costs when no weight band says otherwise — and what it has
   * always meant for a courier priced by one flat rate up to `baseWeightKg`.
   */
  rate        Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  courier   Courier            @relation(fields: [courierId], references: [id], onDelete: Cascade)
  orders    Order[]
  bands     CourierRateBand[]

  @@index([courierId])
  @@index([workspaceId])
}

/**
 * A weight step in one zone's price list: "up to 0.25kg it costs 55".
 *
 * Couriers here price by slab, not by a flat rate with a surcharge on top, and
 * the difference is not academic: Steadfast charges this shop 55 for a 0.15kg
 * Dhaka parcel and 65 for a 0.5kg one, which `baseWeightKg` + `extraKgRate`
 * cannot express — that pair can only ever add money above an included weight,
 * never take it off below one. Every parcel under the limit was over-quoted,
 * and the courier balance carried the difference as an unexplained gap.
 *
 * A zone with no bands behaves exactly as it did: `rate` up to `baseWeightKg`,
 * `extraKgRate` per started kilo above it. With bands, the heaviest band is
 * what the extra-kilo charge is measured from.
 */
/**
 * A payout the courier has made, as the courier itself records it.
 *
 * The one fact the app could never work out on its own: which parcels a
 * payment covered and what it actually paid. Everything else here is derived
 * from orders, and derived was close but never exact — the percentage fee is
 * charged on the payout as a whole and floored to a whole taka, so summing the
 * orders' own figures lands a quarter of a taka out on a good day, and further
 * whenever a returned parcel's bill drags the fee base down.
 *
 * Imported, not entered. `externalId` is the courier's own payment id, and the
 * unique key on it is what makes importing twice a no-op.
 */
model CourierPayout {
  id          String @id @default(cuid())
  workspaceId String
  courierId   String

  /** The courier's own id for this payout — "SFC-31257680". */
  externalId String
  /** What the parcels in it collected, before anything was kept. */
  amount     Decimal @db.Decimal(12, 2)
  /** The delivery charges on those parcels. */
  deliveryBills Decimal @db.Decimal(12, 2)
  /** The percentage fee, as the courier computed it over the whole payout. */
  charges    Decimal @db.Decimal(12, 2)
  /** amount − deliveryBills − charges: what reached the bank. */
  total      Decimal @db.Decimal(12, 2)
  method     String?
  paidAt     DateTime?

  /**
   * The consignment ids it settled, kept verbatim. Enough to answer "which
   * payout paid for this parcel" without a join table for a list that is only
   * ever read whole.
   */
  consignmentIds Json

  /** What the orders behind it added up to, so the difference stays explainable. */
  ordersTotal Decimal @db.Decimal(12, 2)
  importedAt  DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  courier   Courier   @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@unique([courierId, externalId])
  @@index([workspaceId])
}

model CourierRateBand {
  id          String  @id @default(cuid())
  workspaceId String
  zoneId      String
  /** Parcels weighing this or less take `rate`. */
  uptoKg      Decimal @db.Decimal(6, 3)
  rate        Decimal @db.Decimal(12, 2)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  zone      CourierZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
  @@index([workspaceId])
}

enum DeliveryType {
  SELF
  COURIER
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  COURIER_COLLECTION
  OTHER
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

model Customer {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  phone       String?
  altPhone    String?
  address     String?
  notes       String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([workspaceId])
}

model Order {
  id                  String        @id @default(cuid())
  workspaceId         String
  /**
   * A short per-workspace number — 1, 2, 3… — for humans and for couriers.
   * The id is a cuid, which is the right thing for a primary key and the wrong
   * thing to read down a phone line or match against a courier's statement.
   * Steadfast wants a unique `invoice` string per parcel and shows it in its
   * app; "GS-1042" is findable there, "clx8f2k9p0001..." is not.
   * Nullable only so the backfill migration could run; every row has one, and
   * createOrder always assigns one.
   */
  orderNo             Int?
  customerId          String?
  date                DateTime      @default(now())
  /// Whether `date` carries a real time of day, or only a day.
  /// The forms ask for both now, so a new row's `date` is the moment the sale
  /// was made or the money moved. Rows entered before that — and this column is
  /// false for every one of them — hold midnight UTC, and the time worth showing
  /// for those is when they were entered (see lib/dhaka-time). Testing the
  /// timestamp instead of storing this cannot tell the two apart: 6 AM in Dhaka
  /// IS midnight UTC.
  dateHasTime         Boolean       @default(false)
  status              OrderStatus   @default(PENDING)
  deliveryType        DeliveryType  @default(SELF)
  deliveryCharge      Decimal       @default(0) @db.Decimal(12, 2) // charged to the customer
  deliveryCost        Decimal?      @db.Decimal(12, 2) // actual amount paid to the courier; null = assume it equals deliveryCharge (pure pass-through)
  // Which courier carried it, and on which zone rate — kept so the cost can
  // be re-checked later and reconciled against the courier's own statement.
  courierId           String?
  courierZoneId       String?
  weightKg            Decimal?      @db.Decimal(6, 3)
  // The courier's percentage fee on this parcel, in taka. A separate column
  // from deliveryCost because it scales with the order's value rather than
  // its destination, and because a report that can't separate the two can't
  // tell a bad delivery rate from a bad COD rate.
  codFeeCost          Decimal       @default(0) @db.Decimal(12, 2)
  // Money the customer still handed over on a cancelled order — a partial
  // delivery where they paid the shipping and refused the goods. Without it a
  // cancellation looks like a pure loss when it was nearly break-even.
  cancelledCollected  Decimal       @default(0) @db.Decimal(12, 2)
  /**
   * Money the customer paid that never reached the business — a rider who
   * entered a lower COD in the courier's app and pocketed the rest, a parcel
   * settled at a rounded-down figure at the door.
   *
   * Stored as the shortfall rather than as "what was actually collected"
   * because the invoice moves: record a return a week later and a stored 900
   * would quietly stop being short of anything, while the 60 somebody walked
   * off with stays a fact about that delivery. The form still asks for the
   * figure the courier's app shows; the subtraction is this column's job.
   *
   * NOT a receivable. The customer paid in full, so nothing here is owed by
   * them — it is a loss between their hand and the treasury, which is why it
   * lands on profit and never on `amountOutstanding`.
   */
  collectionShortfall Decimal       @default(0) @db.Decimal(12, 2)
  /** Why the money went missing, in the words of whoever found out. */
  collectionNote      String?
  /**
   * Where this cancelled order's goods are — see ReturnLeg.
   *
   * Only ever anything but NONE on a CANCELLED order, and set by the person
   * cancelling it, because nothing else can know: the courier's own status
   * says the parcel was refused, not whether it has been carried back yet.
   */
  returnLeg           ReturnLeg     @default(NONE)
  /** When the leg last moved — sent back, arrived, or written off. */
  returnLegAt         DateTime?
  courierTrackingId   String? // the courier's own order/consignment number (deliveryType=COURIER); shown on the invoice instead of the internal id
  /**
   * The courier's own tracking code, as distinct from the consignment id:
   * Steadfast returns both and its app searches by either.
   */
  courierTrackingCode String?
  /**
   * What the courier last said about this parcel — "in_review", "delivered",
   * "cancelled" — and when it said it.
   * Deliberately NOT the order's status. updateOrderStatus consumes stock,
   * re-quotes the COD fee and, on a cancellation, needs figures a webhook
   * cannot know: what the return trip cost and what the customer handed over
   * at the door. A webhook that wrote straight into `status` would book those
   * as zero and quietly wreck the profit reports. So the courier's word is
   * recorded here, shown as a badge, and applied by a person in one click.
   */
  courierStatus       String?
  courierStatusAt     DateTime?
  /**
   * Set the moment a booking request starts, cleared if it fails.
   * Reading courierTrackingId and then calling the courier leaves a window as
   * long as the courier takes to answer — up to twenty seconds — in which a
   * second click passes the same check and books the same parcel again. This
   * column closes it: the booking claims the order in one conditional write
   * before any HTTP happens, so the second request finds it taken.
   * A timestamp rather than a boolean so a request that dies mid-flight (a
   * crash, a cold serverless container) does not lock the order forever — the
   * claim is treated as stale after two minutes, which is well past the
   * client's own timeout.
   */
  courierBookingAt    DateTime?
  // Where THIS parcel was actually sent, captured when the order was entered.
  //
  // The customer record is the buyer's identity — one row per phone number, so
  // history, dues and repeat-buyer counts all hold together. It is the wrong
  // place to read a delivery address from: the same number orders again to a
  // new address (office instead of home, a gift to a relative), and there is
  // no answer that works. Leave the record alone and the new parcel prints the
  // old address; edit it and every past order is retroactively rewritten to an
  // address it was never sent to.
  //
  // Null on every order that predates this, and on any order whose details
  // simply match the customer's — the documents fall back to the customer
  // record, which is exactly what they did before.
  shipName            String?
  shipPhone           String?
  shipAddress         String?
  /**
   * Which district this parcel's address appears to name, tagged when it was
   * booked. For reports — "how many orders went to Sylhet" — and nothing else.
   * Best-effort and labelled as such: it comes from matching district names in
   * the address text, which is not something to trust for a delivery decision.
   * It is not sent to the courier (there is no field for it — the address line
   * carries everything), it does not decide whether a parcel goes, and nobody
   * types it. Null on an address written in Bangla, or in shorthand, or badly.
   */
  shipDistrict        String?
  paymentMethod       PaymentMethod @default(CASH)
  paymentStatus       PaymentStatus @default(UNPAID)
  // How much of the order the customer has actually handed over. PARTIAL was
  // a status with no number behind it: an advance of 3,000 on a 5,000 order
  // left the app reporting the whole 5,000 as due and the 3,000 sitting
  // nowhere at all — not against the due, not in the treasury.
  //
  // Only read when paymentStatus is PARTIAL. PAID means the whole customer
  // total whatever this says, which is what keeps every order that predates
  // the column behaving exactly as it did.
  amountPaid          Decimal       @default(0) @db.Decimal(12, 2)
  packagingCost       Decimal       @default(0) @db.Decimal(12, 2)
  giftCost            Decimal       @default(0) @db.Decimal(12, 2)
  discount            Decimal       @default(0) @db.Decimal(12, 2) // order-level discount
  /// The goods on this order were given away: the customer pays nothing for
  /// them. Kept as its own fact rather than inferred from a 100% discount,
  /// because the two mean different things — a discount is a price somebody
  /// negotiated, a giveaway is a decision the business made and will want to
  /// count. The server keeps `discount` equal to the goods total while this is
  /// set, so the arithmetic stays in one place and nobody has to type it.
  ///
  /// Says nothing about delivery. A free product can still be shipped at the
  /// customer's expense; leave deliveryCharge at 0 and record deliveryCost for
  /// the shop to bear the trip too.
  isGiveaway          Boolean       @default(false)
  // Where the order came from: website, Facebook, a referral, a stall… Kept as
  // a plain string rather than an enum so adding a channel later is a one-line
  // change instead of a Postgres type migration on a live table. Nullable
  // because every order predating this is genuinely unknown — see
  // ORDER_SOURCES in lib/order-source.
  source              String?
  // Which boosting campaign brought this order in, when somebody knows. Set
  // from the orders list, never guessed: an untagged order still counts
  // towards a campaign's ESTIMATED result (its window and channel), but only
  // a tag makes it exact. SetNull on delete — losing a campaign must not
  // delete sales history.
  boostCampaignId     String?
  heldByMembershipId  String? // which partner/member currently holds this order's cash
  cashInTreasury      Boolean       @default(false) // true once this PAID order's cash is confirmed deposited into the shared treasury
  notes               String?
  createdAt           DateTime      @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  heldBy        Membership?    @relation("OrderHeldBy", fields: [heldByMembershipId], references: [id], onDelete: SetNull)
  boostCampaign BoostCampaign? @relation(fields: [boostCampaignId], references: [id], onDelete: SetNull)
  courier       Courier?       @relation(fields: [courierId], references: [id], onDelete: SetNull)
  courierZone   CourierZone?   @relation(fields: [courierZoneId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  gifts         OrderGift[]
  treasuryEntry TreasuryEntry?

  @@unique([workspaceId, orderNo])
  @@index([workspaceId])
  @@index([workspaceId, date])
  @@index([customerId])
  @@index([status])
  // The pending-return list, and the stock derivation's "still travelling
  // back" term — both ask for one workspace's IN_TRANSIT rows and nothing else.
  @@index([workspaceId, returnLeg])
  @@index([boostCampaignId])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  productVariantId String
  unitPrice        Decimal @db.Decimal(12, 2)
  unitCost         Decimal @db.Decimal(12, 2) // snapshot of cost at sale time
  quantity         Int
  discount         Decimal @default(0) @db.Decimal(12, 2) // line-total discount

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  returns        Return[]

  @@index([orderId])
  @@index([productVariantId])
}

// A free item given away with an order. Never appears on the customer's
// invoice — internal only (sales details / profit math). Either linked to a
// product variant (consumes stock, cost snapshotted server-side) or a custom
// free-text item (manual cost). Order.giftCost stores the summed total so all
// existing profit/report math keeps working unchanged.
model OrderGift {
  id               String  @id @default(cuid())
  orderId          String
  productVariantId String? // null = custom (free-text) gift
  label            String // display name: product label snapshot or the custom text
  quantity         Int     @default(1)
  unitCost         Decimal @default(0) @db.Decimal(12, 2) // per-unit cost snapshot (variant) or manual (custom)

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productVariantId])
}

model Return {
  id           String    @id @default(cuid())
  workspaceId  String
  orderItemId  String
  quantity     Int
  reason       String?
  refundAmount Decimal   @default(0) @db.Decimal(12, 2)
  date         DateTime  @default(now())
  /**
   * When the returned pieces physically arrived back. Null = the customer has
   * sent them and they are still in the post.
   *
   * The same gap a cancelled parcel has (see ReturnLeg), for the same reason:
   * a return recorded the day the customer posts it used to put the goods on
   * the shelf a week before anybody could pack them. Only stock reads this —
   * the refund and the invoice move when the return is agreed, not when the
   * box turns up, so the money side never waits on it.
   *
   * Backfilled to createdAt for every row that predates the column: those
   * returns were recorded on arrival, and leaving them null would have taken
   * stock away that has been on the shelf for months.
   */
  receivedAt   DateTime?
  createdAt    DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([orderItemId])
}

// ── Phase 3: Partner Finance & Treasury ─────────────────────────────

enum PartnerTxnType {
  INVESTMENT // partner puts capital into the business
  EXPENSE // partner spends their own money on a business cost
  WITHDRAWAL // partner takes money out
  DEPOSIT_TO_TREASURY // partner adds cash to the central treasury
}

enum TreasuryDirection {
  IN
  OUT
}

model Partner {
  id                 String   @id @default(cuid())
  workspaceId        String
  userId             String
  profitSharePercent Decimal  @default(0) @db.Decimal(5, 2) // 0–100
  notes              String?
  createdAt          DateTime @default(now())

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  txns              PartnerTxn[]
  treasury          TreasuryEntry[]
  purchases         Purchase[]
  internalPurchases InternalPurchase[]
  boostSpends       BoostDailySpend[]

  @@unique([workspaceId, userId])
  @@index([workspaceId])
}

model PartnerTxn {
  id                 String         @id @default(cuid())
  workspaceId        String
  partnerId          String
  type               PartnerTxnType
  amount             Decimal        @db.Decimal(12, 2)
  purpose            String?
  date               DateTime       @default(now())
  /// Whether `date` carries a real time of day, or only a day.
  /// The forms ask for both now, so a new row's `date` is the moment the sale
  /// was made or the money moved. Rows entered before that — and this column is
  /// false for every one of them — hold midnight UTC, and the time worth showing
  /// for those is when they were entered (see lib/dhaka-time). Testing the
  /// timestamp instead of storing this cannot tell the two apart: 6 AM in Dhaka
  /// IS midnight UTC.
  dateHasTime        Boolean        @default(false)
  distributionId     String? // set when auto-created by a treasury profit distribution (batch, not unique — one distribution fans out to many partner txns)
  // The three "out-of-pocket" links below all mean the same thing: a partner
  // paid for something with their own money, so the business owes them an
  // INVESTMENT credit. Each is unique — one source row, one credit, no drift.
  boostSpendId       String?        @unique // set when auto-created by a partner-funded boost daily spend
  purchaseId         String?        @unique // set when auto-created by a partner-funded product purchase
  internalPurchaseId String?        @unique // set when auto-created by a partner-funded internal purchase
  createdAt          DateTime       @default(now())

  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  partner          Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  distribution     ProfitDistribution? @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  boostSpend       BoostDailySpend?    @relation(fields: [boostSpendId], references: [id], onDelete: Cascade)
  purchase         Purchase?           @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  internalPurchase InternalPurchase?   @relation(fields: [internalPurchaseId], references: [id], onDelete: Cascade)
  // A DEPOSIT_TO_TREASURY txn auto-creates one linked treasury entry.
  treasuryEntry    TreasuryEntry?

  @@index([workspaceId])
  @@index([workspaceId, date])
  @@index([partnerId])
  @@index([distributionId])
}

model TreasuryEntry {
  id                 String            @id @default(cuid())
  workspaceId        String
  type               TreasuryDirection
  amount             Decimal           @db.Decimal(12, 2)
  source             String // e.g. "Partner deposit", "Sales", "Rent"
  note               String?
  date               DateTime          @default(now())
  /// Whether `date` carries a real time of day, or only a day.
  /// The forms ask for both now, so a new row's `date` is the moment the sale
  /// was made or the money moved. Rows entered before that — and this column is
  /// false for every one of them — hold midnight UTC, and the time worth showing
  /// for those is when they were entered (see lib/dhaka-time). Testing the
  /// timestamp instead of storing this cannot tell the two apart: 6 AM in Dhaka
  /// IS midnight UTC.
  dateHasTime        Boolean           @default(false)
  partnerId          String? // which partner this entry is attributed to (optional)
  partnerTxnId       String?           @unique // set when auto-created from a partner txn
  orderId            String?           @unique // set when auto-created by "mark cash deposited" on an order
  purchaseId         String?           @unique // set when auto-created by a treasury-funded product purchase
  internalPurchaseId String?           @unique // set when auto-created by a treasury-funded internal purchase
  distributionId     String?           @unique // set when auto-created by a treasury profit distribution
  boostSpendId       String?           @unique // set when auto-created by a treasury-funded boost daily spend
  createdAt          DateTime          @default(now())

  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  partner          Partner?            @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  partnerTxn       PartnerTxn?         @relation(fields: [partnerTxnId], references: [id], onDelete: Cascade)
  order            Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchase         Purchase?           @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  internalPurchase InternalPurchase?   @relation(fields: [internalPurchaseId], references: [id], onDelete: SetNull)
  distribution     ProfitDistribution? @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  boostSpend       BoostDailySpend?    @relation(fields: [boostSpendId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, date])
  @@index([partnerId])
}

// A single "distribute treasury cash to partners by profit share" batch —
// one treasury OUT (the whole amount taken out) fanning out to one
// WITHDRAWAL PartnerTxn per partner (their normalized cut). Grouped under
// one id so the whole batch is deleted/undone together, never partially.
model ProfitDistribution {
  id          String   @id @default(cuid())
  workspaceId String
  totalAmount Decimal  @db.Decimal(12, 2)
  note        String?
  date        DateTime @default(now())
  /// Whether `date` carries a real time of day, or only a day.
  /// The forms ask for both now, so a new row's `date` is the moment the sale
  /// was made or the money moved. Rows entered before that — and this column is
  /// false for every one of them — hold midnight UTC, and the time worth showing
  /// for those is when they were entered (see lib/dhaka-time). Testing the
  /// timestamp instead of storing this cannot tell the two apart: 6 AM in Dhaka
  /// IS midnight UTC.
  dateHasTime Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  treasuryEntry TreasuryEntry?
  partnerTxns   PartnerTxn[]

  @@index([workspaceId])
  @@index([workspaceId, date])
}

// ── Phase 4: Internal Purchases (non-sales) ─────────────────────────
// Deliberately separate from the sales-product Purchase model — no shared refs.

enum ExpenseCategory {
  OFFICE_SUPPLIES
  PACKAGING_MATERIAL
  EQUIPMENT
  UTILITIES
  OTHER
}

model InternalPurchase {
  id               String          @id @default(cuid())
  workspaceId      String
  itemName         String
  description      String?
  supplierId       String? // preset supplier/shop, picked from the Suppliers list
  supplierName     String? // denormalized supplier name (kept in sync with supplierId); legacy free-text for rows created before supplierId existed
  cost             Decimal         @db.Decimal(12, 2) // unit cost
  quantity         Int             @default(1)
  category         ExpenseCategory @default(OTHER)
  paidByPartnerId  String? // which partner's money funded this purchase (optional)
  paidFromTreasury Boolean         @default(false) // funded from the shared treasury instead of a partner (mutually exclusive with paidByPartnerId)
  /**
   * Bought on account and still owed for — see Purchase.onCredit.
   */
  onCredit         Boolean         @default(false)
  // How many months this cost covers, so it can be charged to them rather than
  // all to the month it was paid in. A year of hosting bought in April is not
  // an April expense; a bus fare is. Null = charge it in full on `date`, which
  // is right for most rows and is what every existing one keeps doing.
  // The cash is unaffected either way — that left when it left, and the
  // treasury already says so.
  spreadMonths     Int?
  date             DateTime        @default(now())
  /// Whether `date` carries a real time of day, or only a day.
  /// The forms ask for both now, so a new row's `date` is the moment the sale
  /// was made or the money moved. Rows entered before that — and this column is
  /// false for every one of them — hold midnight UTC, and the time worth showing
  /// for those is when they were entered (see lib/dhaka-time). Testing the
  /// timestamp instead of storing this cannot tell the two apart: 6 AM in Dhaka
  /// IS midnight UTC.
  dateHasTime      Boolean         @default(false)
  createdAt        DateTime        @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  paidByPartner Partner?       @relation(fields: [paidByPartnerId], references: [id], onDelete: SetNull)
  treasuryEntry TreasuryEntry?
  partnerTxn    PartnerTxn? // the INVESTMENT credit mirroring a partner-funded purchase

  @@index([workspaceId])
  @@index([workspaceId, date])
  @@index([paidByPartnerId])
  @@index([supplierId])
}

// ── Phase 6: Backup & Recovery ──────────────────────────────────────

enum BackupType {
  SHEETS
  JSON
}

enum BackupStatus {
  IN_PROGRESS
  SUCCESS
  FAILED
}

model BackupLog {
  id          String       @id @default(cuid())
  workspaceId String
  type        BackupType
  status      BackupStatus
  triggeredBy String? // userId who triggered it
  fileUrl     String? // Drive URL when uploaded
  payload     String?      @db.Text // full JSON snapshot (local recoverability when no Drive)
  error       String?
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model BackupSetting {
  id            String    @id @default(cuid())
  workspaceId   String    @unique
  googleSheetId String? // per-workspace spreadsheet id
  driveFolderId String? // Drive folder for JSON snapshots
  autoJson      Boolean   @default(false) // include in scheduled JSON backups
  lastJsonAt    DateTime?
  lastSheetsAt  DateTime?
  updatedAt     DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ── Extra: Stock adjustments (damaged / lost / gift / correction) ────

enum StockAdjustmentType {
  DAMAGED
  LOST
  GIFT
  CORRECTION
}

model StockAdjustment {
  id               String              @id @default(cuid())
  workspaceId      String
  productVariantId String
  type             StockAdjustmentType
  delta            Int // signed change to stock (negative removes, positive adds)
  reason           String?
  date             DateTime            @default(now())
  /// Whether `date` carries a real time of day, or only a day.
  /// The forms ask for both now, so a new row's `date` is the moment the sale
  /// was made or the money moved. Rows entered before that — and this column is
  /// false for every one of them — hold midnight UTC, and the time worth showing
  /// for those is when they were entered (see lib/dhaka-time). Testing the
  /// timestamp instead of storing this cannot tell the two apart: 6 AM in Dhaka
  /// IS midnight UTC.
  dateHasTime      Boolean             @default(false)
  createdAt        DateTime            @default(now())

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, date])
  @@index([productVariantId])
}

// ── Personal per-user Google Sheets backup (TECH_SPEC §3, §6) ───────

enum GoogleScope {
  PERSONAL_BACKUP
}

model UserGoogleConnection {
  id           String      @id @default(cuid())
  userId       String      @unique
  scope        GoogleScope @default(PERSONAL_BACKUP)
  accessToken  String      @db.Text // encrypted (AES-256-GCM)
  refreshToken String?     @db.Text // encrypted
  expiryDate   BigInt? // access token expiry (ms epoch)
  sheetId      String? // the user's personal backup spreadsheet
  lastJsonUrl  String? // most recent JSON snapshot file uploaded to the user's own Drive
  workspaceId  String? // which workspace this sheet backs up (set on connect/sync, used by the auto-sync cron)
  connectedAt  DateTime    @default(now())
  lastSyncedAt DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
}

// ── Boosting: ad campaign & daily spend tracking ────────────────────

enum BoostStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model BoostCampaign {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  objective   String? // e.g. "Message", "Engagement", "Sales"
  // Which channel this campaign runs on — one of ORDER_SOURCES, matched
  // against Order.source when estimating results for orders nobody tagged.
  // Null means "don't narrow by channel", which makes the estimate coarser,
  // so the campaign page says so rather than pretending otherwise.
  channel     String?
  status      BoostStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime    @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  adSets    BoostAdSet[]
  orders    Order[] // orders tagged to this campaign by hand

  @@index([workspaceId])
}

model BoostAdSet {
  id          String      @id @default(cuid())
  workspaceId String
  campaignId  String
  name        String
  startDate   DateTime
  endDate     DateTime? // null = still running / end not decided
  dailyBudget Decimal?    @db.Decimal(12, 2) // Facebook-style per-day budget; a day's spend above this gets flagged
  status      BoostStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime    @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  BoostCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  spends    BoostDailySpend[]

  @@index([workspaceId])
  @@index([campaignId])
}

model BoostDailySpend {
  id               String   @id @default(cuid())
  workspaceId      String
  adSetId          String
  date             DateTime // date-only (midnight UTC); Facebook can charge a card several times in one day, so multiple entries per day are expected
  /// Whether `date` carries a real time of day, or only a day.
  /// The forms ask for both now, so a new row's `date` is the moment the sale
  /// was made or the money moved. Rows entered before that — and this column is
  /// false for every one of them — hold midnight UTC, and the time worth showing
  /// for those is when they were entered (see lib/dhaka-time). Testing the
  /// timestamp instead of storing this cannot tell the two apart: 6 AM in Dhaka
  /// IS midnight UTC.
  dateHasTime      Boolean  @default(false)
  amount           Decimal  @db.Decimal(12, 2)
  note             String?
  paidByPartnerId  String? // which partner's money funded this spend (optional)
  paidFromTreasury Boolean  @default(false) // funded from the shared treasury instead of a partner (mutually exclusive with paidByPartnerId)
  createdAt        DateTime @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  adSet         BoostAdSet     @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  paidByPartner Partner?       @relation(fields: [paidByPartnerId], references: [id], onDelete: SetNull)
  treasuryEntry TreasuryEntry?
  partnerTxn    PartnerTxn? // the auto INVESTMENT credit when a partner funded this spend

  @@index([adSetId, date])
  @@index([workspaceId])
  @@index([workspaceId, date])
  @@index([paidByPartnerId])
}

// ── Online order leads (call tracking) ──────────────────────────────
// Orders placed on gedushop.com land here first. This is a TRACKING table
// only: it never touches stock, treasury or profit, and the real Order is
// still created by hand from the sales page exactly as before.
//
// Deliberately holds NO foreign keys to Order/Customer/Membership — only
// plain ids. restoreSnapshot() deletes orders and customers inside one
// transaction, and a Restrict FK from here would make every backup restore
// fail. Plain strings keep this table invisible to that code path.

/**
 * How the phone call went — and nothing else.
 * DELIVERED used to live here, which forced isCallOutcome() to special-case
 * it out of the attempt counter: a parcel arriving is not a call. Where the
 * parcel got to is now read off the linked Order instead (see
 * OrderLead.orderId), so neither column has to answer the other's question.
 * CANCELLED means the customer said no on the phone. An order cancelled after
 * it was entered is the Order's own CANCELLED status, which is a different
 * event with different costs attached.
 */
enum CallStatus {
  NOT_CALLED
  NO_ANSWER
  PHONE_OFF
  WRONG_NUMBER
  CALL_LATER
  CONFIRMED
  CANCELLED
}

model OrderLead {
  id          String @id @default(cuid())
  workspaceId String

  // Kept as a plain string rather than an enum so a second channel (Facebook,
  // phone order) doesn't need an enum migration on a live table later.
  //
  // NOTE: this is how the row ARRIVED (WOOCOMMERCE / MANUAL), not where the
  // customer came from — and it is half of the unique key below, so webhook
  // retries depend on it never changing. The marketing channel is `channel`.
  source     String  @default("WOOCOMMERCE")
  // Which channel the customer came through — the same vocabulary orders use
  // (ORDER_SOURCES in lib/order-source). Null until somebody says; shown as
  // "Not set" rather than guessed, because a wrong channel is worse for
  // judging ad spend than an admitted blank.
  channel    String?
  externalId String // WooCommerce order id
  orderNo    String? // the #1234 shown in the Telegram message
  // WooCommerce's own status. "checkout-draft" means the customer filled the
  // checkout form but never pressed Place order — worth calling, but a very
  // different conversation from a confirmed order, so it's shown in the list.
  wooStatus  String?
  rawPayload Json? // full webhook body, for anything not mapped above

  customerName   String
  phone          String
  altPhone       String?
  address        String?
  itemsText      String   @default("") // "Robotic Aeroplane (Blue) x2" — for reading, not for stock
  // What was agreed for delivery, kept apart from the goods. `total` is the
  // grand total the customer was quoted — the figure the caller repeats back —
  // and without this the two were impossible to separate afterwards: the items
  // added up to one number and the total said another, with nothing to say
  // whether the difference was shipping or a discount.
  //
  // Zero on anything from WooCommerce: its order total already includes
  // shipping and the breakdown isn't carried through the webhook.
  deliveryCharge Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @default(0) @db.Decimal(12, 2)
  orderedAt      DateTime @default(now())

  callStatus     CallStatus @default(NOT_CALLED)
  callAttempts   Int        @default(0)
  lastCalledAt   DateTime?
  calledByName   String? // plain text, not a Membership FK — deleting a member must never be blocked by this table
  customerAdvice String? // what the customer said about sending the product
  internalNote   String?

  convertedCustomerId String? // set once "Create customer" is used; plain id, no relation
  // The real Order this lead became, once one was entered. Plain id with no
  // relation for the same reason as convertedCustomerId above: restoreSnapshot
  // deletes orders inside one transaction, and an FK from here would make
  // every backup restore fail. Where the parcel got to is read off this order
  // rather than typed again on the lead, so the two can never disagree.
  orderId             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, source, externalId]) // webhook retries can't duplicate a lead
  @@index([workspaceId, callStatus])
  @@index([workspaceId, orderedAt])
}

// One row per offline mutation the server has seen, keyed by an id the client
// generates BEFORE it first tries to send.
//
// The outbox replays anything it didn't get an answer for — and "no answer"
// includes the case where the write committed and the connection dropped on
// the way back. Without this the replay re-ran it: a second purchase, a second
// treasury deduction, a second partner credit, for one purchase that happened
// once. The row is written before the handler runs, so the unique constraint
// is what rejects the duplicate rather than a check anyone can race.
//
// Deliberately standalone — plain workspaceId, no relation — for the same
// reason as OrderLead: restoreSnapshot deletes rows inside one transaction and
// an FK from here would make every restore fail.
model ProcessedMutation {
  /**
   * Client-generated, globally unique, stable across retries of the same write.
   */
  requestId   String   @id
  workspaceId String?
  actionType  String
  /**
   * Null while the handler is still running; set once it returns.
   */
  ok          Boolean?
  error       String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// Remembers when the call list last pulled from WooCommerce, so opening the
// page repeatedly doesn't hammer the store. Deliberately standalone — plain
// workspaceId, no relation — for the same reason as OrderLead: restoreSnapshot
// must never trip over it.
model WooSyncState {
  workspaceId String   @id
  lastSyncAt  DateTime @default(now())
  lastResult  String?
}

// Who changed what, and when.
//
// A multi-admin system without this can say what the numbers are and never
// why they moved: an order's delivery cost is 115 today and was 65 yesterday,
// and the only way to find out who typed it was to ask everybody. The PRD has
// asked for an audit trail since v1.0 (§7); this is it.
//
// Written from the action layer, after the write commits, rather than from a
// Prisma extension. An extension sees every attempt: runSerializable retries a
// conflicted transaction, so one created order would log twice, and a rolled
// back transaction would leave a log entry for a change that never happened.
// An audit trail that lies is worse than none.
model ActivityLog {
  id          String @id @default(cuid())
  workspaceId String

  /**
   * Null when nobody was logged in — the WooCommerce webhook and the nightly
   * cron both write real data. `actorLabel` still says who, in words.
   */
  actorMembershipId String?
  /**
   * The actor's name at the time, snapshotted. A membership can be removed and
   * a person can be renamed; the history must still read correctly afterwards.
   */
  actorLabel        String

  action      ActivityAction
  /**
   * Prisma model name — "Order", "Purchase", "TreasuryEntry".
   */
  entity      String
  entityId    String
  /**
   * What the record is called, so a deleted row still reads as something.
   */
  entityLabel String?

  /**
   * One human sentence: "Cancelled — ৳120 collected on a partial delivery".
   */
  summary String
  /**
   * Field-level detail: { field: { from, to } }. Null on CREATE and DELETE,
   * where the summary and the row itself are the whole story.
   */
  changes Json?

  /**
   * Groups the rows written by one user action. Cancelling an order touches
   * the order and its treasury entry; the history shows one line that opens
   * into both, rather than two lines nobody can tell apart.
   */
  groupId String?

  createdAt DateTime @default(now())

  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorMembership Membership? @relation(fields: [actorMembershipId], references: [id], onDelete: SetNull)

  // The activity page reads newest-first per workspace…
  @@index([workspaceId, createdAt])
  // …and a record's own history page reads one entity's rows.
  @@index([workspaceId, entity, entityId, createdAt])
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
}
